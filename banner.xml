<svg xmlns="http://www.w3.org/2000/svg" width="1000" height="245" viewBox="0 0 1000 245">
  <title>Kavya Gupta - Full Stack Developer</title>
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#070709"/>
      <stop offset="50%" stop-color="#0f0709"/>
      <stop offset="100%" stop-color="#050507"/>
    </linearGradient>

    <linearGradient id="redGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ff4458"/>
      <stop offset="40%" stop-color="#ff1a35"/>
      <stop offset="70%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#ff2a45"/>
      <animate attributeName="x1" values="-100%;100%;-100%" dur="7s" repeatCount="indefinite"/>
      <animate attributeName="x2" values="0%;200%;0%" dur="7s" repeatCount="indefinite"/>
    </linearGradient>

    <linearGradient id="borderGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#7f1d1d"/>
      <stop offset="30%" stop-color="#ef4444"/>
      <stop offset="50%" stop-color="#ff4d6d"/>
      <stop offset="70%" stop-color="#ef4444"/>
      <stop offset="100%" stop-color="#7f1d1d"/>
    </linearGradient>

    <filter id="neonGlow" x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <filter id="ambientBlur">
      <feGaussianBlur stdDeviation="35"/>
    </filter>

    <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
      <path d="M30 0H0V30" fill="none" stroke="#ef4444" stroke-width="0.75" stroke-opacity="0.08"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="1000" height="245" rx="16" fill="url(#background)"/>

  <!-- Ambient red lighting -->
  <ellipse cx="200" cy="100" rx="180" ry="100" fill="#dc2626" opacity="0.16" filter="url(#ambientBlur)"/>
  <ellipse cx="800" cy="140" rx="180" ry="100" fill="#ff1a35" opacity="0.14" filter="url(#ambientBlur)"/>

  <!-- Technology grid -->
  <rect width="1000" height="245" rx="16" fill="url(#grid)"/>

  <!-- Neon border -->
  <rect x="2" y="2" width="996" height="241" rx="15" fill="none" stroke="url(#borderGlow)" stroke-width="2" stroke-opacity="0.85"/>

  <!-- Corner accents -->
  <g stroke="#ff2a45" stroke-width="3.5" fill="none" stroke-linecap="round">
    <path d="M20 40V20H40"/>
    <path d="M960 20H980V40"/>
    <path d="M20 205V225H40"/>
    <path d="M960 225H980V205"/>
  </g>

  <!-- Top badge -->
  <rect x="370" y="28" width="260" height="30" rx="15" fill="#17090b" stroke="#ff2a45" stroke-width="1"/>

  <circle cx="389" cy="43" r="5" fill="#ef4444">
    <animate attributeName="opacity" values="0.4;1;0.4" dur="2s" repeatCount="indefinite"/>
  </circle>

  <text x="507" y="47" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="12" font-weight="700"
        letter-spacing="1.5" fill="#ff4d6d">
    BUILDING REAL-WORLD TECH
  </text>

  <!-- Name glow -->
  <text x="500" y="112" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="55" font-weight="900"
        letter-spacing="3" fill="url(#redGlow)"
        filter="url(#neonGlow)">KAVYA GUPTA</text>

  <!-- Main name -->
  <text x="500" y="112" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="55" font-weight="900"
        letter-spacing="3" fill="#ffffff">KAVYA GUPTA</text>

  <!-- Professional subtitle -->
  <text x="500" y="151" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="15" font-weight="700"
        letter-spacing="1.7">
    <tspan fill="#ff4d6d">COMPUTER SCIENCE ENGINEER</tspan>
    <tspan fill="#64748b">  ·  </tspan>
    <tspan fill="#f1f5f9">FULL STACK DEVELOPER</tspan>
  </text>

  <!-- Decorative divider -->
  <g>
    <line x1="220" y1="177" x2="470" y2="177" stroke="url(#borderGlow)" stroke-width="1.5"/>
    <path d="M500 170L507 177L500 184L493 177Z" fill="#ef4444" filter="url(#neonGlow)"/>
    <line x1="530" y1="177" x2="780" y2="177" stroke="url(#borderGlow)" stroke-width="1.5"/>
  </g>

  <!-- Bottom tagline -->
  <text x="500" y="211" text-anchor="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="12" font-weight="600"
        letter-spacing="1.5" fill="#94a3b8">
    <tspan fill="#ef4444">&lt;/&gt;</tspan>
    <tspan> TURNING RANDOM IDEAS INTO PRODUCTION CODE</tspan>
  </text>
</svg>
